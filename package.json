{
  "name": "todo-mcp",
  "version": "1.0.0",
  "description": "Remote MCP Todo server backed by Supabase",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup:db": "tsx --env-file=.env src/scripts/setupDb.ts",
    "test:db": "tsx --env-file=.env src/scripts/testCrud.ts"
  },
  "keywords": [
    "mcp",
    "todo",
    "supabase"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13"
  }
}
